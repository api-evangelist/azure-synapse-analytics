{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Credential",
  "title": "Credential",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "type": "string",
      "description": "Credential type.",
      "enum": [
        "ManagedIdentity",
        "ServicePrincipal"
      ]
    },
    "description": {
      "type": "string"
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "typeProperties": {
      "type": "object",
      "description": "Type-specific properties."
    }
  }
}