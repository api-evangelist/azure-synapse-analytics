{
  "opencollection": "1.0.0",
  "info": {
    "name": "Azure Synapse Analytics - KQL Script API",
    "version": "2021-11-01-preview"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "implicit",
      "authorizationUrl": "https://login.microsoftonline.com/common/oauth2/authorize",
      "credentials": {
        "clientId": "{{clientId}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "KqlScripts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Azure Synapse Analytics List KQL scripts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{workspaceName}.dev.azuresynapse.net/kqlScripts",
            "params": [
              {
                "name": "api-version",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get all KQL scripts in the workspace."
        },
        {
          "info": {
            "name": "Azure Synapse Analytics Get a KQL script",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{workspaceName}.dev.azuresynapse.net/kqlScripts/:kqlScriptName",
            "params": [
              {
                "name": "api-version",
                "value": "",
                "type": "query"
              },
              {
                "name": "kqlScriptName",
                "value": "",
                "type": "path",
                "description": "KQL script name."
              }
            ]
          },
          "docs": "Get KQL script by name."
        },
        {
          "info": {
            "name": "Azure Synapse Analytics Create or update a KQL script",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{workspaceName}.dev.azuresynapse.net/kqlScripts/:kqlScriptName",
            "params": [
              {
                "name": "api-version",
                "value": "",
                "type": "query"
              },
              {
                "name": "kqlScriptName",
                "value": "",
                "type": "path",
                "description": "KQL script name."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates or updates a KQL Script."
        },
        {
          "info": {
            "name": "Azure Synapse Analytics Delete a KQL script",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{workspaceName}.dev.azuresynapse.net/kqlScripts/:kqlScriptName",
            "params": [
              {
                "name": "api-version",
                "value": "",
                "type": "query"
              },
              {
                "name": "kqlScriptName",
                "value": "",
                "type": "path",
                "description": "KQL script name."
              }
            ]
          },
          "docs": "Delete KQL script by name."
        },
        {
          "info": {
            "name": "Azure Synapse Analytics Rename a KQL script",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{workspaceName}.dev.azuresynapse.net/kqlScripts/:kqlScriptName/rename",
            "params": [
              {
                "name": "api-version",
                "value": "",
                "type": "query"
              },
              {
                "name": "kqlScriptName",
                "value": "",
                "type": "path",
                "description": "KQL script name."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Rename a KQL script."
        }
      ]
    }
  ],
  "bundled": true
}