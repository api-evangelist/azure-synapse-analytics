{
  "opencollection": "1.0.0",
  "info": {
    "name": "Azure Synapse Analytics - Notebook API",
    "version": "2020-12-01"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "implicit",
      "authorizationUrl": "https://login.microsoftonline.com/common/oauth2/authorize",
      "credentials": {
        "clientId": "{{clientId}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Notebook",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Azure Synapse Analytics List notebooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{workspaceName}.dev.azuresynapse.net/notebooks",
            "params": [
              {
                "name": "api-version",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Lists notebooks in the workspace."
        },
        {
          "info": {
            "name": "Azure Synapse Analytics List notebook summaries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{workspaceName}.dev.azuresynapse.net/notebooks/summary",
            "params": [
              {
                "name": "api-version",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Lists a summary of notebooks in the workspace."
        },
        {
          "info": {
            "name": "Azure Synapse Analytics Get a notebook",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{workspaceName}.dev.azuresynapse.net/notebooks/:notebookName",
            "headers": [
              {
                "name": "If-None-Match",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "api-version",
                "value": "",
                "type": "query"
              },
              {
                "name": "notebookName",
                "value": "",
                "type": "path",
                "description": "The notebook name."
              }
            ]
          },
          "docs": "Gets a notebook."
        },
        {
          "info": {
            "name": "Azure Synapse Analytics Create or update a notebook",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{workspaceName}.dev.azuresynapse.net/notebooks/:notebookName",
            "headers": [
              {
                "name": "If-Match",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "api-version",
                "value": "",
                "type": "query"
              },
              {
                "name": "notebookName",
                "value": "",
                "type": "path",
                "description": "The notebook name."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates or updates a notebook."
        },
        {
          "info": {
            "name": "Azure Synapse Analytics Delete a notebook",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{workspaceName}.dev.azuresynapse.net/notebooks/:notebookName",
            "params": [
              {
                "name": "api-version",
                "value": "",
                "type": "query"
              },
              {
                "name": "notebookName",
                "value": "",
                "type": "path",
                "description": "The notebook name."
              }
            ]
          },
          "docs": "Deletes a notebook."
        },
        {
          "info": {
            "name": "Azure Synapse Analytics Rename a notebook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{workspaceName}.dev.azuresynapse.net/notebooks/:notebookName/rename",
            "params": [
              {
                "name": "api-version",
                "value": "",
                "type": "query"
              },
              {
                "name": "notebookName",
                "value": "",
                "type": "path",
                "description": "The notebook name."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Renames a notebook."
        }
      ]
    }
  ],
  "bundled": true
}