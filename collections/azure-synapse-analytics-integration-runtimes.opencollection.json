{
  "opencollection": "1.0.0",
  "info": {
    "name": "Azure Synapse Analytics - Integration Runtimes API",
    "version": "2020-12-01"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "implicit",
      "authorizationUrl": "https://login.microsoftonline.com/common/oauth2/authorize",
      "credentials": {
        "clientId": "{{clientId}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "IntegrationRuntimes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Azure Synapse Analytics List integration runtimes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{workspaceName}.dev.azuresynapse.net/integrationRuntimes",
            "params": [
              {
                "name": "api-version",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List integration runtimes in the workspace."
        },
        {
          "info": {
            "name": "Azure Synapse Analytics Get an integration runtime",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{workspaceName}.dev.azuresynapse.net/integrationRuntimes/:integrationRuntimeName",
            "params": [
              {
                "name": "api-version",
                "value": "",
                "type": "query"
              },
              {
                "name": "integrationRuntimeName",
                "value": "",
                "type": "path",
                "description": "Integration runtime name."
              }
            ]
          },
          "docs": "Get an integration runtime."
        }
      ]
    }
  ],
  "bundled": true
}